# Copy this file to .env and fill in the blanks. Never share or commit .env.

# Password for the /admin page. Make it long and hard to guess.
ADMIN_KEY=

# Bank details shown to customers after they order.
# BANK_NAME is the name on the account customers are paying.
BANK_NAME=
SORT_CODE=
ACCOUNT_NUMBER=

# Telegram alerts: new orders and the Wednesday night bake sheet.
# Leave both blank to switch Telegram off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Delivery. Leave BAKERY_POSTCODE blank to offer collection only.
BAKERY_POSTCODE=
# Furthest you will deliver, in miles one way. Blank means 10.
MAX_DELIVERY_MILES=
# Delivery charge in pounds, e.g. 3.50. Blank or 0 means free delivery.
DELIVERY_FEE=
# For working out fuel cost: your car's miles per gallon (e.g. 45)
# and the fuel price in pounds per litre (e.g. 1.45, not 145).
CAR_MPG=
FUEL_PRICE_PER_LITRE=

# Where the orders database file lives. Leave blank to use orders.db in this folder.
DB_PATH=

# Set to 1 to take orders outside Monday-Wednesday (for testing only).
FORCE_OPEN=
